import Foundation
extension Int { static let alertFirstButtonReturn = 1, alertSecondButtonReturn = 2 }
final class NSAlert {
 static let alertFirstButtonReturn = 1, alertSecondButtonReturn = 2
 static var replies: [Int] = []
 var messageText = "", informativeText = ""
 func addButton(withTitle: String) {}
 func runModal() -> Int { precondition(!Self.replies.isEmpty); return Self.replies.removeFirst() }
}
struct HabitTracker {
 var markdown: String
 init(markdown: String = "HABIT:empty") { self.markdown = markdown }
 static func fromMarkdown(_ text: String) -> HabitTracker? { text.hasPrefix("HABIT:") ? HabitTracker(markdown: text) : nil }
}
final class EditorHarness {
 var discardCount = 0
 func discardUndoHistory() { discardCount += 1 }
}
final class Harness {
 let editor = EditorHarness()
 var cardMode = "markdown", text = "", tracker = HabitTracker(), todo = TodoList(), outline = OutlineDocument(), status = ""
 var markdownURL: URL?, habitURL: URL?, todoURL: URL?, outlineURL: URL?
 var markdownFolder: URL?, habitFolder: URL?, todoFolder: URL?, outlineFolder: URL?
 var diskSnapshots: [String: Data] = [:], newDraftBaselines: [String: Data] = [:]
 var fileURL: URL? {
  get { cardMode == "habits" ? habitURL : cardMode == "todos" ? todoURL : cardMode == "outline" ? outlineURL : markdownURL }
  set { if cardMode == "habits" { habitURL = newValue } else if cardMode == "todos" { todoURL = newValue } else if cardMode == "outline" { outlineURL = newValue } else { markdownURL = newValue } }
 }
 var branchSaveFolder: URL? {
  get { cardMode == "habits" ? habitFolder : cardMode == "todos" ? todoFolder : cardMode == "outline" ? outlineFolder : markdownFolder }
  set { if cardMode == "habits" { habitFolder = newValue } else if cardMode == "todos" { todoFolder = newValue } else if cardMode == "outline" { outlineFolder = newValue } else { markdownFolder = newValue } }
 }
 var savedMarkdownSnapshot: String?, savedHabitSnapshot: String?, savedTodoSnapshot: String?, savedOutlineSnapshot: String?, saveTargets: [URL] = []
 var presentedURLs: [URL?] = []
 var history = CardHistory(), suppressHistorySave = false, traversingHistory = false
 func setTracker(_ tracker: HabitTracker) { self.tracker = tracker }
 func setTodo(_ todo: TodoList) { self.todo = todo }
 func setOutline(_ outline: OutlineDocument) { self.outline = outline }
 func decodeMarkdown(_ data: Data) throws -> String {
  let result = String(decoding: data, as: UTF8.self)
  guard Data(result.utf8) == data else { throw NSError(domain: NSCocoaErrorDomain, code: NSFileReadInapplicableStringEncodingError) }
  return result
 }
 func saveMarkdown(saveAs: Bool = false, automatic: Bool = false) -> Bool {
  presentedURLs.append(fileURL)
  let target: URL
  if let current = fileURL, !saveAs { target = current }
  else { guard !saveTargets.isEmpty else { return false }; target = saveTargets.removeFirst() }
  let content = cardMode == "habits" ? tracker.markdown : cardMode == "todos" ? todo.markdown : cardMode == "outline" ? outline.markdown : text
  do { try content.write(to: target, atomically: true, encoding: .utf8) } catch { return false }
  fileURL = target
  if cardMode == "habits" { savedHabitSnapshot = content } else if cardMode == "todos" { savedTodoSnapshot = content } else if cardMode == "outline" { savedOutlineSnapshot = content } else { savedMarkdownSnapshot = content }
  if !suppressHistorySave { history.saveCurrent(target) }
  return true
 }
    // DRAFT_METHODS

}
@main struct Check {
 static func main() throws {
  let temp = FileManager.default.temporaryDirectory.appendingPathComponent("cardify-draft-" + UUID().uuidString, isDirectory: true)
  try FileManager.default.createDirectory(at: temp, withIntermediateDirectories: true)
  defer { try? FileManager.default.removeItem(at: temp) }
  let a = temp.appendingPathComponent("a.md"), b = temp.appendingPathComponent("b.md"), habit = temp.appendingPathComponent("habit.md")
  try "# A".write(to: a, atomically: true, encoding: .utf8)
  try "# B".write(to: b, atomically: true, encoding: .utf8)
  try "HABIT:old".write(to: habit, atomically: true, encoding: .utf8)

  // Existing files are flushed without a save prompt when navigating.
  let saved = Harness(); saved.text = "# A edited"; saved.savedMarkdownSnapshot = "# A"; saved.fileURL = a
  NSAlert.replies = []; precondition(saved.loadFile(b))
  precondition((try? String(contentsOf: a, encoding: .utf8)) == "# A edited" && saved.text == "# B")

  // Cancel preserves a new draft and its destination; discard opens the target.
  let draft = Harness(); draft.text = "# Unsaved"
  NSAlert.replies = [3]; precondition(!draft.loadFile(b))
  precondition(draft.text == "# Unsaved" && draft.fileURL == nil)
  NSAlert.replies = [2]; precondition(draft.loadFile(b))
  precondition(draft.text == "# B" && draft.fileURL == b)

  // Saving a new draft before opening another card keeps its saved content.
  let newFile = temp.appendingPathComponent("new.md")
  let saving = Harness(); saving.text = "# New"; saving.saveTargets = [newFile]
  NSAlert.replies = [1]; precondition(saving.loadFile(b))
  precondition((try? String(contentsOf: newFile, encoding: .utf8)) == "# New" && saving.fileURL == b)

  // Two unsaved drafts get one combined decision, rather than repeated prompts.
  let combined = Harness(); combined.text = "# Research draft"; combined.cardMode = "habits"; combined.tracker = HabitTracker(markdown: "HABIT:draft")
  NSAlert.replies = [3]; precondition(!combined.loadFile(b))
  precondition(NSAlert.replies.isEmpty && combined.cardMode == "habits" && combined.text == "# Research draft" && combined.tracker.markdown == "HABIT:draft")
  NSAlert.replies = [2]; precondition(combined.loadFile(b))
  precondition(NSAlert.replies.isEmpty && combined.cardMode == "markdown" && combined.text == "# B")

  // If a sidebar target is invalidated while the prompt is displayed, retain the draft.
  let stale = Harness(); stale.text = "# Keep"
  var checks = 0; NSAlert.replies = [2]
  precondition(!stale.loadFile(b, validating: { checks += 1; return checks == 1 }))
  precondition(stale.text == "# Keep" && stale.fileURL == nil && stale.status.contains("no longer safely available"))

  // A structured outline opens in the matching mode, without altering Markdown.
  let outlineFile = temp.appendingPathComponent("outline.md")
  let original = OutlineDocument().markdown
  try original.write(to: outlineFile, atomically: true, encoding: .utf8)
  let openedOutline = Harness(); NSAlert.replies = []; precondition(openedOutline.loadFile(outlineFile))
  precondition(openedOutline.cardMode == "outline" && openedOutline.outline.markdown == original)
  print("Draft navigation, autosave handoff, combined prompts, stale targets and outline opening passed")
 }
}
